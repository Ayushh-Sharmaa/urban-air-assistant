# Copy to .env.local — NEVER commit real keys.
# See README.md for setup instructions.

# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DATA_MODE=demo      # demo | live

# ─── LLM (AI Assistant) ───────────────────────────────
# Gemini (default): https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini             # gemini | openai
LLM_MODEL=gemini-1.5-flash      # or gemini-1.5-pro / gpt-4o-mini
LLM_API_KEY=

# ─── Air Quality Data (optional — demo mode works without) ──
# OpenAQ v3: https://openaq.org/developers/
OPENAQ_API_KEY=

# ─── Supabase (optional — for auth and persistent data) ──
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Contact (optional) ───────────────────────────────
CONTACT_EMAIL=                  # Where contact form submissions are sent
